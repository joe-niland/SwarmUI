# Settings for the RunPod auto-scaling scripts in this folder.
# Copy this file outside the repo (default path: ~/.config/swarmui/runpod.env) and fill it in.
# Never commit or bake the filled-in copy into an image: it holds your API key.
# Values are read literally, the same way `docker run --env-file` reads them, so don't quote them.

# A RunPod API key with read/write access to pods and network volumes.
RUNPOD_API_KEY=

# Data centre for the network volume. Only used when creating the volume: worker pods always
# run in the volume's data centre. Leave empty and run `provision.sh volume` for suggestions.
RUNPOD_DATA_CENTER=

# Filled in after `provision.sh volume` creates the volume.
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_NETWORK_VOLUME_SIZE_GB=100

# GPU type IDs from `provision.sh gpus`, separated by commas, in order of preference.
# Each new pod gets the first one in stock in the volume's data centre.
RUNPOD_GPU_TYPE=NVIDIA L40S
RUNPOD_IMAGE=runpod/pytorch:2.2.0-cu1300-torch291-ubuntu2404
RUNPOD_CONTAINER_DISK_GB=30

# Public git repo and branch that hold these scripts. The setup pod clones it onto the volume.
SWARM_REPO_URL=
SWARM_REPO_BRANCH=

# A worker pod deletes itself after this many hours, even if it is still busy.
SWARM_WORKER_MAX_HOURS=4
