# Settings for the RunPod auto-scaling scripts in this folder.
# Copy this file outside the repo (default path: ~/.config/swarmui/runpod.env) and fill it in.
# Never commit or bake the filled-in copy into an image: it holds your API key.
# Values are read literally, the same way `docker run --env-file` reads them, so don't quote them.

# A RunPod API key with read/write access to pods and global volumes.
RUNPOD_API_KEY=

# Filled in after `provision.sh volume` creates the global volume.
RUNPOD_GLOBAL_VOLUME_ID=

# GPU type IDs from `provision.sh gpus` that pods may use, separated by commas.
# Each new pod gets the cheapest one that's in stock.
RUNPOD_GPU_TYPE=NVIDIA L40S,NVIDIA RTX 6000 Ada Generation,NVIDIA RTX PRO 6000 Blackwell Server Edition

RUNPOD_IMAGE=runpod/pytorch:2.2.0-cu1300-torch291-ubuntu2404
RUNPOD_CONTAINER_DISK_GB=30

# Public git repo and branch that hold these scripts. The setup pod clones it.
SWARM_REPO_URL=
SWARM_REPO_BRANCH=

# A worker pod deletes itself after this many hours, even if it is still busy.
SWARM_WORKER_MAX_HOURS=4
